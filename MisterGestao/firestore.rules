rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProduct() {
      return request.resource.data.keys().hasAll([
          'name', 'category', 'brand', 'measure', 'code',
          'price', 'stock', 'minimum', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'brand', 'measure', 'code',
          'price', 'stock', 'minimum', 'createdAt', 'createdBy', 'photo'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.brand is string
        && request.resource.data.measure is string
        && request.resource.data.code is string
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.minimum is int
        && request.resource.data.minimum >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validName() {
      return request.resource.data.keys().hasOnly(['name', 'createdAt', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /lojas/mister-motoplace/produtos/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && validProduct();
      // Venda: só pode baixar o estoque
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
      allow delete: if false;
    }

    match /lojas/mister-motoplace/vendas/{vendaId} {
      allow read: if signedIn();
      // A venda tem o mesmo código do orçamento e só é criada junto com a conversão dele
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orcamentoId', 'cliente', 'total', 'createdAt', 'createdBy'])
        && request.resource.data.orcamentoId == vendaId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.status == 'open'
        && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.status == 'converted'
        && request.resource.data.total
          == get(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.total;
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/marcas/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validName();
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/categorias/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validName();
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/clientes/{clienteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'createdAt', 'createdBy'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.telefone is string
        && request.resource.data.telefone.matches('[1-9]{2}([2-5][0-9]{7}|9[0-9]{8})')
        && clienteId == request.resource.data.telefone
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/orcamentos/{orcamentoId} {
      // Quem tem o link abre um orçamento; listar todos exige login
      allow get: if true;
      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.subtotal is int
        && request.resource.data.desconto is int
        && request.resource.data.desconto >= 0
        && request.resource.data.frete is int
        && request.resource.data.frete >= 0
        && request.resource.data.total is int
        && request.resource.data.total
          == request.resource.data.subtotal
            - request.resource.data.desconto
            + request.resource.data.frete;

      // Confirmar venda: o orçamento aberto passa a convertido, junto com o registro da venda
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'open'
        && request.resource.data.status == 'converted'
        && existsAfter(/databases/$(database)/documents/lojas/mister-motoplace/vendas/$(orcamentoId));

      // A escolha do destinatário só pode alterar o cliente, preservando itens e valores.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente'])
        && request.resource.data.cliente is map
        && request.resource.data.cliente.keys().hasOnly(['id', 'nome', 'contato'])
        && request.resource.data.cliente.id is string
        && request.resource.data.cliente.id.matches('[1-9]{2}([2-5][0-9]{7}|9[0-9]{8})')
        && request.resource.data.cliente.nome
          == get(/databases/$(database)/documents/lojas/mister-motoplace/clientes/$(request.resource.data.cliente.id)).data.nome
        && request.resource.data.cliente.contato
          == get(/databases/$(database)/documents/lojas/mister-motoplace/clientes/$(request.resource.data.cliente.id)).data.telefone;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
