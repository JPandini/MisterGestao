rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validProductCategory(dados) {
      return dados.category is string
        && dados.categoryId is string
        && dados.category
          == get(/databases/$(database)/documents/lojas/mister-motoplace/categorias/$(dados.categoryId)).data.name;
    }

    function validProductPhoto(dados) {
      return !('photo' in dados)
        || (dados.photo is string
          && dados.photo.size() <= 700000
          && dados.photo.matches('data:image/jpeg;base64,.*'));
    }

    function validProductCost(dados) {
      return dados.costPrice is int
        && dados.costPrice > 0
        && dados.profitPercentage is number
        && dados.profitPercentage >= -100
        && dados.profitPercentage <= 90071992547409;
    }

    function validProduct() {
      return request.resource.data.keys().hasAll([
          'name', 'category', 'categoryId', 'brand', 'measure', 'code',
          'price', 'costPrice', 'profitPercentage', 'stock', 'minimum', 'createdAt', 'createdBy'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'categoryId', 'brand', 'measure', 'code',
          'price', 'costPrice', 'profitPercentage', 'stock', 'minimum', 'createdAt', 'createdBy', 'photo'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validProductCategory(request.resource.data)
        && request.resource.data.brand is string
        && request.resource.data.measure is string
        && request.resource.data.code is string
        && request.resource.data.code.matches('[A-Z]{3}-[0-9]{3,}')
        && validProductPhoto(request.resource.data)
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && validProductCost(request.resource.data)
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.minimum is int
        && request.resource.data.minimum >= 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function validProductEdit() {
      let dados = request.resource.data;
      let campos = dados.diff(resource.data).affectedKeys();
      return campos.hasOnly(['name', 'category', 'categoryId', 'brand', 'measure',
          'price', 'costPrice', 'profitPercentage', 'minimum', 'photo'])
        && (!campos.hasAny(['name']) || (dados.name is string && dados.name.size() > 0))
        && (!campos.hasAny(['category', 'categoryId']) || validProductCategory(dados))
        && (!campos.hasAny(['brand']) || (dados.brand is string && dados.brand.size() > 0))
        && (!campos.hasAny(['measure']) || dados.measure is string)
        && (!campos.hasAny(['minimum']) || (dados.minimum is int && dados.minimum >= 0))
        && (!campos.hasAny(['photo']) || validProductPhoto(dados))
        && (!campos.hasAny(['price', 'costPrice', 'profitPercentage'])
          || (dados.price is int && dados.price > 0
            && ((!campos.hasAny(['costPrice', 'profitPercentage'])
                && dados.get('costPrice', null) == null && dados.get('profitPercentage', null) == null)
              || validProductCost(dados))));
    }

    function validName() {
      return request.resource.data.keys().hasOnly(['name', 'createdAt', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    match /lojas/mister-motoplace/produtos/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && validProduct()
        && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/sequenciasProdutos/$(request.resource.data.categoryId)).data.productId == productId
        && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/sequenciasProdutos/$(request.resource.data.categoryId)).data.code == request.resource.data.code;
      allow update: if signedIn() && validProductEdit();
      // Entradas e vendas movimentam o saldo pelo fluxo de estoque.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock != resource.data.stock;
      allow delete: if false;
    }

    match /lojas/mister-motoplace/sequenciasProdutos/{categoryId} {
      function validSequence() {
        let dados = request.resource.data;
        let prefix = dados.prefix;
        let numero = dados.lastNumber;
        let sufixo = numero < 10 ? '00' + string(numero)
          : (numero < 100 ? '0' + string(numero) : string(numero));
        return prefix.matches('[A-Z]{3}')
          && dados.keys().hasAll(['prefix', 'lastNumber', 'code', 'productId'])
          && dados.keys().hasOnly(['prefix', 'lastNumber', 'code', 'productId'])
          && numero is int && numero > 0 && numero <= 999999999
          && dados.code == prefix + '-' + sufixo
          && dados.productId is string
          && !exists(/databases/$(database)/documents/lojas/mister-motoplace/produtos/$(dados.productId))
          && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/produtos/$(dados.productId)).data.categoryId == categoryId
          && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/produtos/$(dados.productId)).data.code == dados.code;
      }
      allow read: if signedIn();
      // A primeira sequência pode continuar códigos manuais anteriores.
      allow create: if signedIn() && validSequence();
      allow update: if signedIn() && validSequence()
        && request.resource.data.prefix == resource.data.prefix
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    // A validade dura até o fim do dia no horário da loja (Brasília, UTC-3).
    function withinValidity(dados) {
      return !('validade' in dados) || dados.validade == ''
        || (dados.validade is string && dados.validade.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.time < timestamp.date(int(dados.validade.split('-')[0]),
            int(dados.validade.split('-')[1]), int(dados.validade.split('-')[2])) + duration.value(27, 'h'));
    }

    function withinSaleWindow(dados) {
      return withinValidity(dados) && (
        !('createdAt' in dados) || !(dados.createdAt is timestamp)
        || request.time < dados.createdAt + duration.value(8, 'd')
      );
    }

    match /lojas/mister-motoplace/vendas/{vendaId} {
      allow read: if signedIn();
      // A venda tem o mesmo código do orçamento e só é criada junto com a conversão dele
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['orcamentoId', 'cliente', 'total', 'createdAt', 'createdBy'])
        && request.resource.data.orcamentoId == vendaId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && withinSaleWindow(get(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(vendaId)).data)
        && get(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.status == 'open'
        && getAfter(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.status == 'converted'
        && request.resource.data.total
          == get(/databases/$(database)/documents/lojas/mister-motoplace/orcamentos/$(request.resource.data.orcamentoId)).data.total;
      allow update, delete: if false;
    }

    // Histórico de estoque: entrada (+) ou venda (-), nunca muda depois de criado
    match /lojas/mister-motoplace/movimentos/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['produtoId', 'produto', 'quantidade', 'tipo', 'createdAt', 'createdBy'])
        && request.resource.data.produtoId is string
        && request.resource.data.produto is string
        && request.resource.data.quantidade is int
        && ((request.resource.data.tipo == 'entrada' && request.resource.data.quantidade > 0)
          || (request.resource.data.tipo == 'venda' && request.resource.data.quantidade < 0))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/marcas/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validName();
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/categorias/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validName();
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/clientes/{clienteId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'createdAt', 'createdBy'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && request.resource.data.telefone is string
        && request.resource.data.telefone.matches('[1-9]{2}([2-5][0-9]{7}|9[0-9]{8})')
        && clienteId == request.resource.data.telefone
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /lojas/mister-motoplace/orcamentos/{orcamentoId} {
      // Quem tem o link abre um orçamento; listar todos exige login
      allow get: if true;
      allow list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && !('reminderDay' in request.resource.data)
        && request.resource.data.itens is list
        && request.resource.data.itens.size() > 0
        && request.resource.data.subtotal is int
        && request.resource.data.subtotal >= 0
        && request.resource.data.desconto is int
        && request.resource.data.desconto >= 0
        && request.resource.data.desconto <= request.resource.data.subtotal
        && request.resource.data.frete is int
        && request.resource.data.frete >= 0
        && request.resource.data.total is int
        && request.resource.data.validade is string
        && request.resource.data.validade.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && withinValidity(request.resource.data)
        // No máximo 7 dias de validade (8 dias de folga por causa do fuso horário)
        && timestamp.date(int(request.resource.data.validade.split('-')[0]),
            int(request.resource.data.validade.split('-')[1]),
            int(request.resource.data.validade.split('-')[2])) < request.time + duration.value(8, 'd')
        && request.resource.data.total
          == request.resource.data.subtotal
            - request.resource.data.desconto
            + request.resource.data.frete;

      // Confirmar venda: o orçamento aberto passa a convertido, junto com o registro da venda
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && resource.data.status == 'open'
        && withinSaleWindow(resource.data)
        && request.resource.data.status == 'converted'
        && existsAfter(/databases/$(database)/documents/lojas/mister-motoplace/vendas/$(orcamentoId));

      // Cancelamento mantém o orçamento e seus valores, sem criar venda ou alterar estoque.
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/lojas/mister-motoplace/vendas/$(orcamentoId));

      // A escolha do destinatário só pode alterar o cliente, preservando itens e valores.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente'])
        && request.resource.data.cliente is map
        && request.resource.data.cliente.keys().hasOnly(['id', 'nome', 'contato'])
        && request.resource.data.cliente.id is string
        && request.resource.data.cliente.id.matches('[1-9]{2}([2-5][0-9]{7}|9[0-9]{8})')
        && request.resource.data.cliente.nome
          == get(/databases/$(database)/documents/lojas/mister-motoplace/clientes/$(request.resource.data.cliente.id)).data.nome
        && request.resource.data.cliente.contato
          == get(/databases/$(database)/documents/lojas/mister-motoplace/clientes/$(request.resource.data.cliente.id)).data.telefone;
      allow delete: if false;
    }

    match /dispositivosPush/{token} {
      // A posse do token do Expo permite registrar novamente a instalação após uma troca de conta.
      allow create, update: if signedIn()
        && token.matches('(Expo|Exponent)PushToken\\[[A-Za-z0-9_-]{1,128}\\]')
        && request.resource.data.keys().hasOnly(['uid', 'vinculadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.vinculadoEm == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    match /usuarios/{uid}/notificacoesOrcamentos/{notificacaoId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida'])
        && request.resource.data.lida == true;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
